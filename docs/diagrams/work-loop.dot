// Work loop: wake names one action and predicate; the agent satisfies it and wakes again.
digraph work_loop {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=11, labelloc=t, label="Work loop: act until the predicate holds; leave the record; wake", nodesep=0.5, ranksep=0.6];
  node  [shape=box, style=rounded, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10];

  wake [shape=oval, label="sudus wake is read-only:\nprint verdict, action or party, reason and predicate\n(missing refs, pending transition or recovery: one line, exit 3)"];
  verdict [shape=diamond, label="Verdict?"];

  waiting [label="Waiting: print the escalation's five fields verbatim;\nthe agent adds nothing to the work, asks the developer in prose\nand records their answer with sudus answer\n(developer: absent: same print, exit 4)"];
  answer [label="The agent asks the developer in conversation and records the words:\nsudus answer ok | instead | ask --quote;\nsigned when a key exists, attested otherwise"];
  reply [label="reply after ask:\na reply record names the escalation"];

  stop [shape=box, peripheries=2, label="Done: a done record exists and nothing waits;\nrender unread queue and stop\n(backlog waiting: wake names promote)"];

  act [label="Do the named action until its predicate holds\n(the table below is in precedence order)"];
  cannot [shape=diamond, label="Cannot act, or cycle bound reached?"];
  escalate [label="Write one evidence-backed escalation;\ncycle guard: fourth same-target or 28th admin transition,\nor third unsuccessful recovery"];
  measure [label="Consequential decision while acting:\nsudus measure the draft first\n(five Score levels, composite, veto, suggested: advice, not a route)"];
  gate [shape=diamond, label="Floor or veto?"];
  decide [label="The agent decides: sudus decide --consequential\n(composite outcome, whatever the suggestion),\nor escalates anyway"];
  trace [label="Leave the required trace:\nbranch commit, typed snapshot or canonical log record"];

  actions [shape=plaintext, fontsize=9, label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#eeeeee"><B>Action</B></TD><TD BGCOLOR="#eeeeee"><B>done :=</B></TD></TR>
      <TR><TD ALIGN="LEFT">repair PATH</TD><TD ALIGN="LEFT">hand-written input parses; no unrelated byte changed</TD></TR>
      <TR><TD ALIGN="LEFT">recover TRANSACTION</TD><TD ALIGN="LEFT">intent has a terminal domain or abort record; every store matches its result</TD></TR>
      <TR><TD ALIGN="LEFT">reconcile ACTION</TD><TD ALIGN="LEFT">local action lease is gone; action finished or was abandoned</TD></TR>
      <TR><TD ALIGN="LEFT">scope PATH</TD><TD ALIGN="LEFT">each durable breach is developer-kept or restored to its allowed base; later declaration never clears it</TD></TR>
      <TR><TD ALIGN="LEFT">supersede SLUG</TD><TD ALIGN="LEFT">each set requirement's Agreed text has the digest its start froze, or a superseded record closes the commitment</TD></TR>
      <TR><TD ALIGN="LEFT">fix ITEM</TD><TD ALIGN="LEFT">fix snapshot changes no protected contract; requirement has a current pass</TD></TR>
      <TR><TD ALIGN="LEFT">record PATH</TD><TD ALIGN="LEFT">action lease covers the path, or it is clean</TD></TR>
      <TR><TD ALIGN="LEFT">commit PATH</TD><TD ALIGN="LEFT">path is clean, or the action lease covers it</TD></TR>
      <TR><TD ALIGN="LEFT">declare REQ</TD><TD ALIGN="LEFT">mechanism definition names REQ; no prior undeclared delta was legalized</TD></TR>
      <TR><TD ALIGN="LEFT">run REQ</TD><TD ALIGN="LEFT">current receipt matches input snapshot, definition, text and declared execution identity</TD></TR>
      <TR><TD ALIGN="LEFT">implement REQ</TD><TD ALIGN="LEFT">current pass plus review metadata bound to current definition and frozen text, with fail receipt</TD></TR>
      <TR><TD ALIGN="LEFT">escalate REQ</TD><TD ALIGN="LEFT">after three failing attempts, an escalation exists before a fourth</TD></TR>
      <TR><TD ALIGN="LEFT">review mechanism REQ</TD><TD ALIGN="LEFT">review metadata binds definition and text to a fail receipt; product inputs unchanged</TD></TR>
      <TR><TD ALIGN="LEFT">capture ITEM</TD><TD ALIGN="LEFT">outside record or escalation names it</TD></TR>
      <TR><TD ALIGN="LEFT">review SLUG</TD><TD ALIGN="LEFT">current workspace snapshot; every fixed question answered for each target</TD></TR>
      <TR><TD ALIGN="LEFT">report SLUG</TD><TD ALIGN="LEFT">a report at the reviewed snapshot through the latest brief; every lens, decision and interface attempted; a report stopped on a Sudus bug is not one</TD></TR>
      <TR><TD ALIGN="LEFT">resolve SLUG N</TD><TD ALIGN="LEFT">a resolution, or a decline with its reason, names N on its exact source record</TD></TR>
      <TR><TD ALIGN="LEFT">build DECISION</TD><TD ALIGN="LEFT">realized line names base and result snapshots; actual delta passes protected-category check</TD></TR>
      <TR><TD ALIGN="LEFT">backlog DECISION</TD><TD ALIGN="LEFT">a backlog item names the decision a supersession carried and the commitment rests on nowhere</TD></TR>
      <TR><TD ALIGN="LEFT">done SLUG</TD><TD ALIGN="LEFT">Done rule holds; sudus done writes the final record</TD></TR>
      <TR><TD ALIGN="LEFT">fold ITEM</TD><TD ALIGN="LEFT">no commitment is open; every inbox item this clone holds is on the log, or another item holds its slug</TD></TR>
      <TR><TD ALIGN="LEFT">promote</TD><TD ALIGN="LEFT">one backlog item, decision, roadmap move and successor start are one transaction</TD></TR>
    </TABLE>>];

  wake -> verdict;
  verdict -> waiting [label="Waiting"];
  waiting -> answer -> wake;
  verdict -> reply [label="Resolvable: reply"];
  reply -> wake;
  verdict -> stop [label="Done"];
  verdict -> act [label="Resolvable"];
  act -> cannot;
  cannot -> trace [label="can act"];
  cannot -> escalate [label="cannot or bounded"];
  trace -> wake; escalate -> wake;
  act -> measure [label="Consequential draft"];
  measure -> gate;
  gate -> escalate [label="yes: escalate --consequential"];
  gate -> decide [label="no"];
  decide -> trace [label="decision names the measurement"];
  decide -> escalate [label="escalate anyway", style=dashed];
  act -> actions [style=dashed, arrowhead=none];
  { rank=same; act; actions; }
}
